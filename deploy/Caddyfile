{$DOMAIN:localhost} {
    encode gzip zstd

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    reverse_proxy app:8080 {
        health_uri /healthz
        health_interval 10s
        health_timeout 3s
    }
}
