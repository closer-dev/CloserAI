# Окружение: dev | prod
APP_ENV=dev
HTTP_ADDR=:8080
PUBLIC_URL=http://localhost:8080

# Postgres (используется docker-compose и приложением)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=closer_ai
# для локального запуска (make dev-api); в Docker адрес переопределяется в compose
DATABASE_URL=postgres://postgres:postgres@localhost:5432/closer_ai?sslmode=disable

# Секреты: в проде обязательно заменить!
# JWT_SECRET: openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-change-me
# ENCRYPTION_KEY: 32 байта в base64, openssl rand -base64 32
ENCRYPTION_KEY=ZGV2LWVuY3J5cHRpb24ta2V5LTMyLWJ5dGVzLWxvbmc=

# Почта для кодов подтверждения. Пустой SMTP_HOST — письма выводятся в лог (make logs).
# Порт 587 — STARTTLS, 465 — TLS сразу.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CloserAI <noreply@localhost>

# Telegram: webhook | polling
TG_MODE=polling

# Ollama
OLLAMA_URL=http://localhost:11434
LLM_CHAT_MODEL=qwen2.5:3b-instruct
LLM_EMBED_MODEL=bge-m3
